rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 管理者：admins コレクションに自分の uid のドキュメントがある人
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortString(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // お稽古ノート：ログインした本人だけが、自分のノートを読み書きできる
    match /users/{userId}/notes/{noteId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ニックネーム：本人だけが読み書きできる
    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'updatedAt'])
        && shortString(request.resource.data.nickname, 1, 20);
    }

    // 管理者の名簿：本人が「自分は管理者か」を確かめるためだけに読める（書き込みはコンソールから）
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    // みんなのお稽古：誰でも読める。書けるのはログインしてニックネームを決めた本人だけ（写真は投稿の中に保存）
    match /posts/{postId} {
      allow read: if true;
      // 写真（image）は任意。ひとことか写真のどちらかは必要
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'image', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.text, 0, 280)
        && (request.resource.data.text.size() >= 1 || 'image' in request.resource.data)
        && (!('image' in request.resource.data)
            || (request.resource.data.image is string
                && request.resource.data.image.size() <= 600000
                && request.resource.data.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && request.resource.data.nickname
             == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.nickname
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 通報：ログインした人が送れる。読めるのは管理者だけ
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'reason', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && shortString(request.resource.data.postId, 1, 100)
        && shortString(request.resource.data.reason, 0, 200)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
